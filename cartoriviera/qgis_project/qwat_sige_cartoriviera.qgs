WHEN  "installation_type"  = 'treatment' THEN 'T. '&#xd;&#xd;&#xd;&#xd;
ELSE ''&#xd;&#xd;&#xd;&#xd;
END&#xd;&#xd;&#xd;&#xd;
|| coalesce(name,'')</previewExpression>
